  "    return latinDigits(s).toLowerCase()",
  "      .replace(/[ً-ْـ]/g, '')",
  "      .replace(/[أإآ]/g, 'ا')",
  "      .replace(/ة/g, 'ه')",
  "      .replace(/ى/g, 'ي');",
  "  }",
  "",
  "  /** Normalises any way of writing an Egyptian number to the local form, e.g. +20 10… → 010… */",
  "  function localPhone(p) {",
  "    let d = latinDigits(p).replace(/\\D/g, '');",
  "    if (d.indexOf('00') === 0) d = d.slice(2);",
  "    if (d.indexOf('20') === 0 && d.length === 12) d = '0' + d.slice(2);",
  "    if (d.length === 10 && d.charAt(0) === '1') d = '0' + d;",
  "    return d;",
  "  }",
  "",
  "  /** International form used for calls and WhatsApp: \"2\" + local number (010… → 2010… = +20 10…). */",
