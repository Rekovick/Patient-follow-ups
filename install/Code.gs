  "  }",
  "",
  "  function anesItems(a) {",
  "    const base = S.lists.anesthesiaItems.slice();",
  "    Object.keys((a && a.items) || {}).forEach(k => { if (base.indexOf(k) < 0) base.push(k); });",
  "    return base;",
  "  }",
  "",
