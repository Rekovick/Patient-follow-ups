  "  };",
  "  const PALETTE = ['teal', 'rose', 'orange', 'slate', 'amber', 'blue', 'violet'];",
  "",
  "  function tone(status) {",
  "    const k = String(status || '').toLowerCase().trim();",
  "    if (KNOWN_TONES[k]) return KNOWN_TONES[k];",
  "    let h = 0;",
  "    for (let i = 0; i < k.length; i++) h = (h * 31 + k.charCodeAt(i)) >>> 0;",
  "    return PALETTE[h % PALETTE.length];",
  "  }",
  "",
  "  function isDone(p) {",
  "    return p.status === S.doneStatus;",
  "  }",
  "",
