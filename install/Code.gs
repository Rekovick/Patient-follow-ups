  "    if (!d) return '';",
  "    return d.charAt(0) === '0' ? '2' + d : '20' + d;",
  "  }",
  "",
  "  function telHref(p) {",
  "    return 'tel:+' + intlPhone(p);",
  "  }",
  "",
  "  function waHref(p, text) {",
  "    return 'https://wa.me/' + intlPhone(p) + (text ? '?text=' + encodeURIComponent(text) : '');",
  "  }",
  "",
  "  function prettyPhone(p) {",
  "    const d = localPhone(p);",
  "    return /^0\\d{10}$/.test(d) ? d.replace(/^(\\d{3})(\\d{4})(\\d{4})$/, '$1 $2 $3') : (d || String(p || ''));",
  "  }",
  "",
  "  function validMobile(p) {",
